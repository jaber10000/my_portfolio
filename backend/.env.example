# --- LLM provider: "gemini" (default) or "openai" (any OpenAI-compatible API: Groq, OpenRouter, ...)
LLM_PROVIDER=gemini

# Gemini — key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Other LLM (only if LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Comma-separated list of frontend origins allowed to call this API (add your deployed domain!)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://jaber-portfolio.web.app,https://jaber-portfolio.firebaseapp.com
RATE_LIMIT_PER_MIN=20
